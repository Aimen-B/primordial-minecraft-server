{
  "chapter.1000000000000001.title": "Settle in",
  "quest.2000000000000101.title": "Welcome to Primordial",
  "quest.2000000000000101.quest_desc": [
    "This guide is optional. Open your inventory and click the quest book in the top-left sidebar. Each page has a manual checkmark: tick it when you feel ready. Nothing here locks crafting or exploration. Mix any weapons and spells you enjoy."
  ],
  "quest.2000000000000102.title": "Make a shared home",
  "quest.2000000000000102.quest_desc": [
    "Gather wood, make tools, and choose a place to meet. Place a bed and sleep at night. Keep food and spare tools at home. PvP is off, but avoid testing spells near friends until you know their effects."
  ],
  "quest.2000000000000103.title": "Food before adventure",
  "quest.2000000000000103.quest_desc": [
    "Bring cooked food, torches, blocks, a pickaxe and a shield. JEI is the item list beside your inventory: search an item and press R over it for its recipe. Keep your first trip close to home."
  ],
  "chapter.1000000000000002.title": "Your first magic",
  "quest.2000000000000201.title": "Find your first spellbook",
  "quest.2000000000000201.quest_desc": [
    "Search spell book in JEI and inspect the available recipes. Iron's Spells uses spellbooks, scrolls and mana. Start with an accessible book, then collect scrolls and magic resources while exploring. You do not need to choose a permanent class."
  ],
  "quest.2000000000000202.title": "Prepare a spell",
  "quest.2000000000000202.quest_desc": [
    "Read the tooltip on a scroll and check whether your book can accept it. Search inscription table in JEI to see the recipe and uses. Use the mod's progression guide at iron.wiki/progression if you want more detail."
  ],
  "quest.2000000000000203.title": "Practise safely",
  "quest.2000000000000203.quest_desc": [
    "Open Options > Controls and search spell. Check your spell selection and casting keys. Practise a simple spell outside your home, away from friends, pets and valuable builds. Watch mana and cooldowns. Terrain damage from spells is disabled."
  ],
  "chapter.1000000000000003.title": "Find your fighting style",
  "quest.2000000000000301.title": "Try light and heavy weapons",
  "quest.2000000000000301.quest_desc": [
    "Search @simplyswords in JEI. Compare attack speed, damage and reach. Try an accessible fast weapon and a slower heavy weapon before choosing a favourite. Rare unique weapons are longer-term exploration goals."
  ],
  "quest.2000000000000302.title": "Mix melee and magic",
  "quest.2000000000000302.quest_desc": [
    "Better Combat gives supported weapons different attack sequences. Some weapons support dual wielding, while others are two-handed. Read tooltips and try your preferred combination. You can always change your equipment."
  ],
  "quest.2000000000000303.title": "Learn to roll",
  "quest.2000000000000303.quest_desc": [
    "Open Options > Controls and search roll. Practise moving sideways and rolling in a safe clearing. Rolling needs food and has a cooldown; it does not grant invulnerability in this pack. Avoid rolling toward cliffs."
  ],
  "chapter.1000000000000004.title": "Your first expedition",
  "quest.2000000000000401.title": "Discover a waystone",
  "quest.2000000000000401.quest_desc": [
    "Find or craft a waystone and activate it. You must discover destinations before travelling to them. Travel costs no XP; item cooldowns still apply. Name your home waystone clearly so the group can regroup."
  ],
  "quest.2000000000000402.title": "Choose a small adventure",
  "quest.2000000000000402.quest_desc": [
    "Scout a modest structure first. Large towers, ships and fortresses can be much harder than ordinary survival even on Normal. Retreat if needed, mark the location, and return with better equipment. Never feel obliged to clear everything now."
  ],
  "quest.2000000000000403.title": "Everyone gets a turn",
  "quest.2000000000000403.quest_desc": [
    "Open supported Lootr containers yourself: their loot is personal, so each friend should check the chest. Ordinary storage chests are still shared. Agree on a meeting point before splitting up."
  ],
  "chapter.1000000000000005.title": "Recover and choose what is next",
  "quest.2000000000000501.title": "Know your grave",
  "quest.2000000000000501.quest_desc": [
    "After death, your equipment is stored in a protected grave. Keep the location message and use the recovery compass supplied on respawn. Right-click your own grave to retrieve your gear. Grave theft and timed expiry are disabled. Do not die deliberately to complete this page."
  ],
  "quest.2000000000000502.title": "Plan a recovery trip",
  "quest.2000000000000502.quest_desc": [
    "If a grave is in danger, ask a friend to escort you and take spare supplies. Graves prefer your last grounded position. Use /yigd to inspect your grave information. If a grave is inaccessible, ask the host for recovery help rather than repeatedly dying."
  ],
  "quest.2000000000000503.title": "Pick the next adventure",
  "quest.2000000000000503.quest_desc": [
    "Choose together: improve a spellbook, hunt for a unique weapon, explore another structure, or improve your base. No quest rewards grant powerful equipment. Tell the host which parts felt fun, confusing or too difficult before adding more mods."
  ]
}